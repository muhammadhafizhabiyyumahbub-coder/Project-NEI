# NEI environment template — copy to .env and fill in real values.
# Never commit .env to git.

# LLM provider (OpenAI-compatible endpoint)
NEI_LLM_PROVIDER=openai-compatible
NEI_LLM_BASE_URL=https://api.example.com/v1
NEI_LLM_API_KEY=your-key-here
NEI_LLM_MODEL=your-model-name

# Privacy: set to "on" to disable all external LLM calls (template-only planner)
NEI_LLM_PRIVACY=off

# Daily token cap (0 = unlimited)
NEI_LLM_DAILY_TOKEN_CAP=500000

# LLM call timeout (seconds)
NEI_LLM_TIMEOUT_S=60

# Data root (absolute or relative to project root)
NEI_DATA_ROOT=./data

# Connector timeouts
NEI_CONNECTOR_TIMEOUT_S=300
NEI_EMERGENCY_TIMEOUT_S=300

# API server
NEI_API_HOST=127.0.0.1
NEI_API_PORT=8000
